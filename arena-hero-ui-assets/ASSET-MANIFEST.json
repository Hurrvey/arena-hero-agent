{
  "name": "Arena Hero Agent UI Assets",
  "version": "1.0.0",
  "theme": "dark-tactical",
  "license": "GPL-3.0",
  "recommendedFontStack": "Inter, Noto Sans SC, Microsoft YaHei, system-ui, sans-serif",
  "colors": {
    "background": "#07111F",
    "panel": "#0D1B2C",
    "friendly": "#2D9CFF",
